{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    ":dependencyDashboard",
    ":semanticCommits"
  ],
  "timezone": "Europe/Paris",
  "baseBranches": ["dev"],
  "schedule": ["before 6am on monday"],
  "labels": ["dependencies"],
  "dependencyDashboardTitle": "Dependency Dashboard — Dockerhand",
  "prConcurrentLimit": 5,
  "prHourlyLimit": 2,
  "rangeStrategy": "bump",
  "minimumReleaseAge": "2 days",
  "rebaseWhen": "behind-base-branch",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["fnsys/dockhand"],
      "groupName": "Dockhand upstream image",
      "commitMessageTopic": "Dockhand",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/base-debian"],
      "groupName": "Home Assistant base image",
      "semanticCommitType": "chore",
      "semanticCommitScope": "base",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "chore",
      "semanticCommitScope": "actions",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^dockhand/Dockerfile$/"],
      "matchStrings": ["FROM fnsys/dockhand:v(?<currentValue>[^\\s]+) AS dockhand"],
      "datasourceTemplate": "docker",
      "depNameTemplate": "fnsys/dockhand",
      "versioningTemplate": "docker"
    }
  ]
}
