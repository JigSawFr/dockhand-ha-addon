{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "timezone": "Europe/Paris",
  "schedule": [
    "before 6am on monday"
  ],
  "labels": [
    "dependencies"
  ],
  "dependencyDashboard": true,
  "prConcurrentLimit": 5,
  "semanticCommits": "enabled",
  "rangeStrategy": "bump",
  "packageRules": [
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["fnsys/dockhand"],
      "groupName": "Dockhand upstream image",
      "commitMessageTopic": "Dockhand",
      "semanticCommitType": "chore",
      "semanticCommitScope": "deps",
      "automerge": false
    },
    {
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/home-assistant/base-debian"],
      "groupName": "Home Assistant base image",
      "semanticCommitType": "chore",
      "semanticCommitScope": "base",
      "automerge": false
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "automerge": false
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dockhand/Dockerfile$/"
      ],
      "matchStrings": [
        "FROM fnsys/dockhand:v(?<currentValue>[^\\s]+) AS dockhand"
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "fnsys/dockhand",
      "versioningTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": [
        "/^dockhand/config\\.yaml$/"
      ],
      "matchStrings": [
        "# renovate: datasource=docker depName=fnsys/dockhand\\nversion: \\\"(?<currentValue>[^\\\"]+)\\\""
      ],
      "datasourceTemplate": "docker",
      "depNameTemplate": "fnsys/dockhand",
      "versioningTemplate": "docker"
    }
  ]
}
