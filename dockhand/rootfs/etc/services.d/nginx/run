#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
# ==============================================================================
# Start nginx (after Dockhand is listening on port 3000)
# ==============================================================================
bashio::log.info "Waiting for Dockhand to be ready on port 3000..."
bashio::net.wait_for 3000 127.0.0.1 60

mkdir -p \
    /tmp/nginx \
    /tmp/nginx/client_temp \
    /tmp/nginx/proxy_temp \
    /tmp/nginx/fastcgi_temp \
    /tmp/nginx/uwsgi_temp \
    /tmp/nginx/scgi_temp

if ! /usr/bin/dockhand-seed-ha-environment; then
    bashio::log.warning "Home Assistant environment seed failed; continuing startup."
fi

bashio::log.info "Starting nginx ingress proxy..."
exec nginx -g "daemon off;"
