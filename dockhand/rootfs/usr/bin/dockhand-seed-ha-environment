#!/usr/bin/with-contenv bashio
# shellcheck shell=bash
set -euo pipefail

log_info() {
    if declare -F bashio::log.info >/dev/null 2>&1; then
        bashio::log.info "$@"
    else
        printf 'INFO: %s\n' "$*"
    fi
}

log_warning() {
    if declare -F bashio::log.warning >/dev/null 2>&1; then
        bashio::log.warning "$@"
    else
        printf 'WARN: %s\n' "$*" >&2
    fi
}

config_true() {
    local key="$1"
    if declare -F bashio::config.true >/dev/null 2>&1; then
        bashio::config.true "$key"
    else
        [ "${DOCKHAND_TEST_SEED_HA_ENVIRONMENT:-true}" = "true" ]
    fi
}

sql_quote() {
    printf "%s" "$1" | sed "s/'/''/g"
}

if ! config_true 'seed_home_assistant_environment'; then
    log_info "Home Assistant environment seed disabled."
    exit 0
fi

DB=${DOCKHAND_DB_PATH:-/data/db/dockhand.db}
NAME=${DOCKHAND_HOME_ASSISTANT_ENV_NAME:-Home Assistant}
SOCKET=${DOCKHAND_HOME_ASSISTANT_SOCKET:-/var/run/docker.sock}
LABELS=${DOCKHAND_HOME_ASSISTANT_ENV_LABELS:-}
if [ -z "$LABELS" ]; then
    LABELS='["ha"]'
fi
REQUIRE_SOCKET=${DOCKHAND_SEED_REQUIRE_SOCKET:-true}

if ! command -v sqlite3 >/dev/null 2>&1; then
    log_warning "sqlite3 unavailable; cannot seed Home Assistant environment."
    exit 0
fi

if [ ! -f "$DB" ]; then
    log_info "Dockhand database not found yet; skipping Home Assistant environment seed."
    exit 0
fi

if [ "$REQUIRE_SOCKET" = "true" ] && [ ! -S "$SOCKET" ]; then
    log_info "Docker socket ${SOCKET} not available; skipping Home Assistant environment seed."
    exit 0
fi

has_table=$(sqlite3 "$DB" "SELECT COUNT(1) FROM sqlite_master WHERE type = 'table' AND name = 'environments';")
if [ "$has_table" != "1" ]; then
    log_info "Dockhand environments table not ready yet; skipping Home Assistant environment seed."
    exit 0
fi

q_name=$(sql_quote "$NAME")
q_socket=$(sql_quote "$SOCKET")
q_labels=$(sql_quote "$LABELS")

changes=$(sqlite3 "$DB" <<SQL
INSERT OR IGNORE INTO environments (
    name,
    host,
    port,
    protocol,
    tls_skip_verify,
    icon,
    collect_activity,
    collect_metrics,
    highlight_changes,
    labels,
    connection_type,
    socket_path,
    created_at,
    updated_at
)
SELECT
    '${q_name}',
    NULL,
    2375,
    'http',
    0,
    'globe',
    1,
    1,
    1,
    '${q_labels}',
    'socket',
    '${q_socket}',
    CURRENT_TIMESTAMP,
    CURRENT_TIMESTAMP
WHERE NOT EXISTS (
    SELECT 1 FROM environments
    WHERE lower(name) = lower('${q_name}')
       OR (connection_type = 'socket' AND socket_path = '${q_socket}')
);
SELECT changes();
SQL
)

if [ "${changes##*$'\n'}" = "1" ]; then
    log_info "Created default Home Assistant Docker environment."
else
    log_info "Home Assistant Docker environment already exists; no seed needed."
fi
